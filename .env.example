APP_NAME=Child Usage Analysis API
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/tesis
API_V1_PREFIX=/api/v1
DEVICE_LINK_CODE_TTL_MINUTES=10
DEVICE_LINK_CODE_HASH_SECRET=replace-with-a-long-random-secret
ADULT_AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
ADULT_AUTH_JWT_EXP_MINUTES=60
ADULT_OTP_TTL_MINUTES=10
ADULT_OTP_MAX_ATTEMPTS=5
# Shared PostgreSQL sliding-window controls for OTP requests and verification.
OTP_RATE_WINDOW_MINUTES=15
OTP_REQUEST_EMAIL_LIMIT=3
OTP_REQUEST_IP_LIMIT=10
OTP_REQUEST_COOLDOWN_SECONDS=60
OTP_VERIFY_EMAIL_LIMIT=10
OTP_VERIFY_IP_LIMIT=30
# Shared persistent limits for public profile creation and link-code flows.
LINK_RATE_WINDOW_MINUTES=15
LINK_CLAIM_IP_LIMIT=10
LINK_CLAIM_ADULT_LIMIT=5
LINK_CODE_ISSUE_PROFILE_LIMIT=5
LINK_CODE_ISSUE_IP_LIMIT=20
PROFILE_CREATE_IP_LIMIT=10
# Exact Caddy peer IP/CIDR only; empty means use the transport peer.
OTP_TRUSTED_PROXY_CIDRS=
EXPOSE_DEV_OTP=false
# Required: development (local only) or ses. Production requires ses.
OTP_EMAIL_PROVIDER=development
SES_REGION=us-east-1
SES_SENDER_EMAIL=
SES_TIMEOUT_SECONDS=5
AUTO_APPROVE_REPRESENTATIVE_VERIFICATION=false
# Exactly two distinct complete email addresses, comma-separated; leave empty by default.
AUTO_APPROVE_REPRESENTATIVE_EMAIL_ALLOWLIST=
DEVICE_AUTH_JWT_SECRET=replace-with-a-different-32-character-random-secret
DEVICE_AUTH_JWT_EXP_MINUTES=43200
DEVICE_BOOTSTRAP_TTL_MINUTES=10
# Optional policy marker only; no automatic snapshot deletion is enabled yet.
# USAGE_SNAPSHOT_RETENTION_DAYS=365
# Optional F12 raw-evidence expiry; cleanup runs on the next upload for the profile.
# Leave unset until the project approves a retention period.
# F12_EVIDENCE_RETENTION_DAYS=365
# Durable F12 -> C1 automation. Keep disabled until a controlled local validation.
F12_AUTOMATIC_PROCESSING_ENABLED=false
F12_AUTOMATIC_PROCESSING_POLL_SECONDS=5
F12_AUTOMATIC_PROCESSING_LEASE_SECONDS=300
F12_AUTOMATIC_PROCESSING_RETRY_SECONDS=30
F12_AUTOMATIC_PROCESSING_MAX_ATTEMPTS=3
ANALYTICS_SERVICE_URL=http://analytics:8765
ANALYTICS_SERVICE_TOKEN=
ANALYTICS_TIMEOUT_SECONDS=5
# Fictitious child-offer tests only. Never enable in production. Comma-separated UUIDs.
CHILD_OFFERS_TEST_ENABLED=false
CHILD_OFFERS_TEST_PROFILE_IDS=
# Optional Docker overrides; source is the extracted Analytics delivery.
ANALYTICS_IMAGE=modera-analytics:04f1e3a
ANALYTICS_SOURCE_DIR=C:/Users/Juan/Projects/modera-analytics-zip/MODERA_ANALYTICS_INTEGRACION_04f1e3a

